    "version": "2.0.0",
    "tasks": [
        {
            "label": "Raylib Example - Generate Bindings",
            "type": "shell",
            "command": "odin run .",
            "options": {
                "cwd": "${workspaceFolder}/raylib_example/bindings_generator"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Raylib Example - Run Example",
            "type": "shell",
            "command": "odin run .",
            "options": {
                "cwd": "${workspaceFolder}/raylib_example/"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Example - Generate Bindings",
            "type": "shell",
            "command": "odin run .",
            "options": {
                "cwd": "${workspaceFolder}/example/bindings_generator"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Example - Debug",
            "type": "shell",
            "command": "odin build . -debug",
            "options": {
                "cwd": "${workspaceFolder}/example/bindings_generator"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Example - Run Example",
            "type": "shell",
            "command": "odin run .",
            "options": {
                "cwd": "${workspaceFolder}/example/"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ]
}